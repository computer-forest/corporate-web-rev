NEXT_PUBLIC_APP_ENV=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_CMS_BASE_URL=
NEXT_PUBLIC_REDIRECTION_URL=
NEXT_PUBLIC_DEMAT_REDIRECT_URL=

# ---------------------------------------------------------------------------
# Home page CMS (the cms-website app).
#
# Read server-side only. No NEXT_PUBLIC_ prefix on either: the token must not
# reach the browser, and the browser never calls the CMS. Leave both blank and
# the home page renders the copy in src/constants/sbi-home.ts, exactly as it
# did before the CMS existed.
# ---------------------------------------------------------------------------
HOME_CMS_URL=
HOME_CMS_TOKEN=
